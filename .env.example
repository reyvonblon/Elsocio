# Copia este archivo a .env y llena tus datos reales. .env NUNCA se sube a Git (ver .gitignore).

# 1. Cuenta Gmail dedicada a El Socio
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=elsociotuia@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion-de-16-caracteres
SMTP_FROM=elsociotuia@gmail.com
IMAP_HOST=imap.gmail.com
MAX_DAILY_EMAILS=15

# Firma comercial
FROM_NAME=Raymond Vonblon
WHATSAPP=+57 304 609 0036
WEBSITE=https://reyvonblon.github.io/Elsocio/

# 2. Cerebro Autónomo IA (Anthropic — tope compartido entre ventas y contenido)
ANTHROPIC_API_KEY=
SALES_AGENT_MODEL=claude-sonnet-5
SALES_AGENT_MAX_EMAILS=15
SALES_AGENT_MAX_DAILY_USD=0.50
# Mix diario por defecto: 2 Reels + 1 Post + 2 Historias + 1 Carrusel (deja vacío CONTENT_MAX_DAILY_PIECES para usarlo)
CONTENT_MAX_DAILY_PIECES=
# CONTENT_DAILY_CAROUSELS=1

# 3. Publicación Autónoma en Instagram (API oficial de Meta — Instagram Graph API)
IG_USER_ID=
IG_ACCESS_TOKEN=
# Para cambiar un token corto (EAA.../EAG...) por uno de pagina que NO vence:
#   python3 scripts/renovar_token_ig.py --token "EAA...el-corto"
# Los dos datos salen de la consola de Meta: la app -> Configuracion -> Basica.
IG_APP_ID=
IG_APP_SECRET=
IG_AUTO_PUBLISH=1
IG_MAX_DAILY_POSTS=
# IG_DAILY_CAROUSELS=1

# 4. Voz Humana Neuronal para Reels (2ª gen multilingüe fluida calibrada al ADN de Raymond)
# VOZ DEFINITIVA (aprobada por Raymond 2026-11-24): la de `redes/voz/voz_definitiva_socio.m4a`
# = Giuseppe Multilingual a +4%. No cambiar sin que él lo pida.
# Alternativas 0 USD listas: `fr-FR-RemyMultilingualNeural` (más grave/calmada) o `es-CO-GonzaloNeural` (acento CO).
VOICE_PROVIDER=edge_neural
VOICE_NAME=it-IT-GiuseppeMultilingualNeural
VOICE_RATE=+4%
VOICE_PITCH=+0Hz
# Opcionales si algún día prefieres voz clonada o de estudio paga:
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# 5. Notificaciones push al celular cuando algo falle de verdad (app gratis "ntfy", sin cuenta).
# Instrucciones completas: scripts/notificar.py. Déjalo vacío para no recibir nada.
NTFY_TOPIC=
