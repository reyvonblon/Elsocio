# Copia este archivo a .env y llena tus datos reales. .env NUNCA se sube a Git (ver .gitignore).

# Cuenta Gmail dedicada a El Socio (crea una nueva, no uses tu correo personal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion-de-16-caracteres
SMTP_FROM=tu-correo@gmail.com
IMAP_HOST=imap.gmail.com

# Cuántos correos de outreach como máximo al día (empieza en 15, sube solo si no hay rebotes/spam)
MAX_DAILY_EMAILS=15

# Firma
FROM_NAME=Raymond Vonblon
WHATSAPP=+57 3XX XXX XXXX
WEBSITE=
